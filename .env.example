# Server configuration. The default fake works offline without a model server.
# Copy to .env for local configuration. Never put real credentials in this file.
# .env is not loaded automatically; export settings in the shell when needed.
LLM_PROVIDER=fake
# MODEL_PROVIDER remains a legacy fallback when LLM_PROVIDER is unset.
# The fake never calls a live model and needs no credential.
MODEL_NAME=offline-fake
MODEL_TIMEOUT_SECONDS=60
# To generate locally, select LLM_PROVIDER=ollama and install the named model.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b-instruct
OLLAMA_NUM_CTX=16384
# Reserved for a future live adapter. Never sent to the fake or browser.
MODEL_API_KEY=
DATABASE_PATH=./data/author_avatar.sqlite3

# LOCAL DEMO ONLY. Generate two different opaque tokens; never commit real values.
# Source .env.demo in the server shell. Public deployment needs real authentication.
DEMO_TOKEN_A=
DEMO_TOKEN_B=
MEMORY_CONTEXT_BYTES=4000
# One shared deadline for rewrite, author, review, optional revision and final review.
# At most five model calls including rewriting; there is no deadline reset per stage.
CHAT_DEADLINE_SECONDS=60
# Shared database-backed model work capacity across app workers using this DB.
MODEL_MAX_CONCURRENT_TURNS=1

# Optional standalone scripts/test_bedrock.py probe; unused by /chat.
# Install the bedrock extra first. Keep the real token only in your ignored .env.
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=
AWS_BEARER_TOKEN_BEDROCK=
